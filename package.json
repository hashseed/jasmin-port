{
  "name": "jasmin-port",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:headless": "esbuild src/headless/run.ts --bundle --platform=node --target=node22 --log-level=warning --outfile=dist/headless/run.js",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:ui": "ng test --watch=false",
    "conformance": "npm run build:headless && JASMIN_TS_RUNNER='node dist/headless/run.js' bash spec/conformance/run-conformance.sh ts",
    "e2e": "playwright test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.headless.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "angular-eslint": "22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
